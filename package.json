{
  "name": "fish-frenzy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "npm run start",
    "test": "vitest",
    "test:ci": "vitest run",
    "emulators": "firebase emulators:start",
    "cap:sync": "npx cap sync",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "functions:build": "npm --prefix functions ci && npm --prefix functions run build",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,database",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy": "firebase deploy --only firestore:rules,database,functions",
    "cap:assets": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas": "^3.2.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.20.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
