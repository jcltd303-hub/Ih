rules_version = '2';
service cloud.firestore {
  // NOTE: package writes only via Admin SDK (Cloud Functions)

  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile: owner read; wallet writes only via Admin SDK (Cloud Functions)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /wallet/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId)
          && !('sweepstakesCoins' in request.resource.data)
          && !('goldCoins' in request.resource.data);
      }

      match /loadout/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Public fairness metadata only. The active server seed and nonce live
      // under serverSessionState and are never client-readable.
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Block arbitrary subcollection writes (prevents client balance tampering)
      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Active fairness seeds, nonces, and payout state are server-only.
    // Admin SDK used by Cloud Functions bypasses Firestore security rules.
    match /serverSessionState/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /tables/{tableId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == playerId;
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /compliance_audit_logs/{logId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['userId', 'timestamp'])
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /deposits/{depId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}