rules_version = '2';
service cloud.firestore {
  // NOTE: package writes only via Admin SDK (Cloud Functions)

  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /wallet/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId)
          && !('sweepstakesCoins' in request.resource.data)
          && !('goldCoins' in request.resource.data);
      }

      // Loadout is cosmetic/client-owned. Financial entitlements such as
      // skinBonus are deliberately excluded from this client-writable path.
      match /loadout/{docId} {
        allow read, write: if isOwner(userId)
          && !('skinBonus' in request.resource.data);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Financial entitlements are server-only. Cloud Functions Admin SDK
    // bypasses these client security rules when granting legitimate bonuses.
    match /serverEntitlements/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /serverSessionState/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /tables/{tableId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == playerId;
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /compliance_audit_logs/{logId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['userId', 'timestamp'])
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /deposits/{depId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
